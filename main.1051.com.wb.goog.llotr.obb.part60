attribute vec4 VERTEX_INPUT_PREANIM_Position;
attribute vec4 VERTEX_INPUT_PREANIM_Weights;
attribute vec4 VERTEX_INPUT_PREANIM_Index;
attribute vec3 VERTEX_INPUT_PREANIM_Normal;
attribute vec3 VERTEX_INPUT_PREANIM_Tangent;
attribute vec2 VERTEX_INPUT_PREANIM_TexCoord0;

varying highp vec4 xlv_TEXCOORD0;
varying highp vec4 xlv_TEXCOORD6;
varying highp vec4 xlv_TEXCOORD1;
varying highp vec4 xlv_TEXCOORD1_1;
varying highp vec4 xlv_TEXCOORD3;
varying highp vec4 xlv_TEXCOORD3_1;
varying highp vec4 xlv_TEXCOORD5;
varying highp vec4 xlv_TEXCOORD6;
varying highp vec4 xlv_COLOR0;
varying highp float xlv_FOG;

void main() {
    MAIN_OUTPUT xl_retval;
    VERTEX_INPUT_PREANIM xlt_VertInPreAnim;
    xlt_VertInPreAnim.Position = vec4(VERTEX_INPUT_PREANIM_Position);
    xlt_VertInPreAnim.Weights = vec4(VERTEX_INPUT_PREANIM_Weights);
    xlt_VertInPreAnim.Index = ivec4(VERTEX_INPUT_PREANIM_Index);
    xlt_VertInPreAnim.Normal = vec3(VERTEX_INPUT_PREANIM_Normal);
    xlt_VertInPreAnim.Tangent = vec3(VERTEX_INPUT_PREANIM_Tangent);
    xlt_VertInPreAnim.TexCoord[0] = vec2(VERTEX_INPUT_PREANIM_TexCoord0);

    xl_retval = xlat_main( xlt_VertInPreAnim);

    gl_Position = vec4(xl_retval.Position);
    xlv_TEXCOORD0 = vec4(xl_retval.AlbOut.TexCoord);
    xlv_TEXCOORD6 = vec4(xl_retval.ShadowCoord[0]);
    xlv_TEXCOORD1 = vec4(xl_retval.LightOut.DirLight[0]);
    xlv_TEXCOORD1_1 = vec4(xl_retval.LightOut.DirLight[1]);
    xlv_TEXCOORD3 = vec4(xl_retval.LightOut.PtLight[0]);
    xlv_TEXCOORD3_1 = vec4(xl_retval.LightOut.PtLight[1]);
    xlv_TEXCOORD5 = vec4(xl_retval.LightOut.SpotLight);
    xlv_TEXCOORD6 = vec4(xl_retval.LightOut.SpotDir);
    xlv_COLOR0 = vec4(xl_retval.LightOut.Colour);
    xlv_FOG = float(xl_retval.Fog);
}


